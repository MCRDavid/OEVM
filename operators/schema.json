{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Auth": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "none",
            "header",
            "query_param",
            "unknown"
          ],
          "title": "Method",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Header or query parameter that carries the key, for example 'ec-subscription-key' or 'apiKey'. Write 'unknown' if not yet known.",
          "title": "Name"
        },
        "secret_name": {
          "anyOf": [
            {
              "description": "NAME of the GitHub Actions secret that holds the key, for example 'JOLT_API_KEY'. Never the key itself.",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Name"
        },
        "scheme": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Word sent before the key in a header, such as 'Token' for 'Authorization: Token <key>'. Null if the header holds only the key.",
          "title": "Scheme"
        }
      },
      "required": [
        "method"
      ],
      "title": "Auth",
      "type": "object"
    },
    "DocumentedLimit": {
      "additionalProperties": false,
      "description": "One rate limit an operator, or the host serving its data, publishes.",
      "properties": {
        "publisher": {
          "description": "Who publishes the limit: the operator, or the company hosting its data, for example 'Eco-Movement'.",
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "requests": {
          "description": "How many requests are allowed per window.",
          "exclusiveMinimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "per_seconds": {
          "description": "Length of the window in seconds.",
          "exclusiveMinimum": 0,
          "title": "Per Seconds",
          "type": "number"
        },
        "endpoint": {
          "anyOf": [
            {
              "enum": [
                "versions",
                "locations",
                "tariffs",
                "statuses",
                "download"
              ],
              "type": "string"
            },
            {
              "const": "all",
              "type": "string"
            }
          ],
          "default": "all",
          "description": "The endpoint the limit applies to, or 'all'.",
          "title": "Endpoint"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Narrower scope within the endpoint, for example 'single location'.",
          "title": "Scope"
        },
        "quote": {
          "description": "The operator's own wording, quoted exactly.",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https?://\\S+$",
          "title": "Source Url",
          "type": "string"
        },
        "checked": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "description": "Date the wording was last read at source_url (YYYY-MM-DD), or 'unknown'.",
          "title": "Checked"
        }
      },
      "required": [
        "publisher",
        "requests",
        "per_seconds",
        "quote",
        "source_url",
        "checked"
      ],
      "title": "DocumentedLimit",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "status": {
          "description": "'documented' if the operator or its host documents this URL, otherwise 'needs_testing'.",
          "enum": [
            "documented",
            "needs_testing"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "url",
        "status"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "Engagement": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "open_anonymous",
            "open_shared_key",
            "key_on_request",
            "signed_agreement_required",
            "requested_no_reply",
            "request_declined",
            "no_public_feed_found",
            "possibly_out_of_scope",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "Engagement",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "description": "Date the evidence was checked (YYYY-MM-DD), or 'unknown'.",
          "title": "Date"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "file": {
          "anyOf": [
            {
              "pattern": "^evidence/[a-z0-9_]+/[^/].*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path of a saved copy under evidence/<operator id>/. No personal names or email addresses.",
          "title": "File"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "date"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "Something observed about a source: a spec difference, a data quirk or an access issue.",
      "properties": {
        "date": {
          "description": "Date it was observed (YYYY-MM-DD).",
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "kind": {
          "enum": [
            "spec_conformance",
            "data_quality",
            "access",
            "documentation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "description": "One neutral, factual sentence.",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "handling": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What this project does about it.",
          "title": "Handling"
        },
        "evidence_url": {
          "anyOf": [
            {
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Url"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "resolved_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Date"
        }
      },
      "required": [
        "date",
        "kind",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Licence": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Licence the data is used under, for example 'OGL-3.0', or 'unknown'.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Link to the licence text.",
          "title": "Url"
        },
        "basis": {
          "description": "Why this licence applies, in plain words, and what the operator's own pages say about terms.",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "checked": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "description": "Date the operator's own terms were last checked (YYYY-MM-DD), or 'unknown'.",
          "title": "Checked"
        }
      },
      "required": [
        "name",
        "basis",
        "checked"
      ],
      "title": "Licence",
      "type": "object"
    },
    "MissingPublishFlag": {
      "additionalProperties": false,
      "description": "The repository owner's recorded decision to show locations that have no publish flag.\n\nOCPI 2.2.1 requires every location to have a publish flag, and a location with publish\nset to false may not be shown on a website or app. Without this decision, locations\nwith no flag are never kept. A flag set to false is always respected, whatever is\nrecorded here.",
      "properties": {
        "decided": {
          "description": "Date the owner made the decision (YYYY-MM-DD).",
          "format": "date",
          "title": "Decided",
          "type": "string"
        },
        "basis": {
          "description": "Why locations with no flag may be shown, for example that the operator publishes the feed itself as open data under the regulations.",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence_url": {
          "description": "Where the operator says the data is public.",
          "pattern": "^https?://\\S+$",
          "title": "Evidence Url",
          "type": "string"
        }
      },
      "required": [
        "decided",
        "basis",
        "evidence_url"
      ],
      "title": "MissingPublishFlag",
      "type": "object"
    },
    "RateLimit": {
      "additionalProperties": false,
      "properties": {
        "min_seconds_between_requests": {
          "default": 2,
          "description": "Gap this project leaves between any two requests to the operator's host, retries included. At least 1 second, and at least 1 second more than every documented limit needs.",
          "minimum": 1.0,
          "title": "Min Seconds Between Requests",
          "type": "number"
        },
        "limits": {
          "description": "Limits the operator publishes. Empty if none.",
          "items": {
            "$ref": "#/$defs/DocumentedLimit"
          },
          "title": "Limits",
          "type": "array"
        },
        "limits_checked": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "default": "unknown",
          "description": "Date the operator's pages were last checked for rate limits. With no limits listed, a date here means none were stated.",
          "title": "Limits Checked"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Anything else about request rates.",
          "title": "Notes"
        }
      },
      "title": "RateLimit",
      "type": "object"
    },
    "Relay": {
      "additionalProperties": false,
      "description": "The repository owner's recorded decision to fetch this operator through a relay the\nproject runs, because the operator's server refused requests from the daily run.\n\nThe relay (relay/worker.js, on Cloudflare Workers) forwards only this operator's own\nfeed paths, unchanged, with the project's User-Agent, and the operator's rate limits\nstill apply. Records keep the operator's own URLs as their source. Only feeds that need\nno key may be relayed, so no key ever passes through it.",
      "properties": {
        "decided": {
          "description": "Date the owner made the decision (YYYY-MM-DD).",
          "format": "date",
          "title": "Decided",
          "type": "string"
        },
        "reason": {
          "description": "Why direct requests cannot be used.",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_url": {
          "description": "Where the refusal can be seen, such as a run log.",
          "pattern": "^https?://\\S+$",
          "title": "Evidence Url",
          "type": "string"
        },
        "url_variable": {
          "description": "Environment variable (a GitHub Actions secret, so it is masked in logs) holding the relay's https address. Requests go direct only when neither this nor secret_name is set; one without the other stops the operator's fetch.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Url Variable",
          "type": "string"
        },
        "secret_name": {
          "description": "Environment variable (a GitHub Actions secret) holding the relay's access token.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Secret Name",
          "type": "string"
        },
        "path_prefix": {
          "description": "The relay path for this operator, for example /geniepoint.",
          "pattern": "^/[a-z0-9-]+$",
          "title": "Path Prefix",
          "type": "string"
        }
      },
      "required": [
        "decided",
        "reason",
        "evidence_url",
        "url_variable",
        "secret_name",
        "path_prefix"
      ],
      "title": "Relay",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Must match the file name.",
      "pattern": "^[a-z0-9_]+$",
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "ocpi_country_code": {
      "pattern": "^([A-Z]{2}|unknown)$",
      "title": "Ocpi Country Code",
      "type": "string"
    },
    "ocpi_party_id": {
      "pattern": "^([A-Z0-9]{3}|unknown)$",
      "title": "Ocpi Party Id",
      "type": "string"
    },
    "adapter": {
      "enum": [
        "ocpi_221",
        "eco_movement_pcpr",
        "gridserve",
        "static_file",
        "custom",
        "unknown"
      ],
      "title": "Adapter",
      "type": "string"
    },
    "base_url": {
      "anyOf": [
        {
          "pattern": "^https?://\\S+$",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ],
      "title": "Base Url"
    },
    "endpoints": {
      "additionalProperties": {
        "$ref": "#/$defs/Endpoint"
      },
      "description": "Specific URLs, recorded only where the source of the URL is known.",
      "propertyNames": {
        "enum": [
          "versions",
          "locations",
          "tariffs",
          "statuses",
          "download"
        ]
      },
      "title": "Endpoints",
      "type": "object"
    },
    "auth": {
      "$ref": "#/$defs/Auth"
    },
    "rate_limit": {
      "$ref": "#/$defs/RateLimit"
    },
    "supports_single_location": {
      "enum": [
        "supported",
        "not_supported",
        "needs_testing",
        "unknown"
      ],
      "title": "Supports Single Location",
      "type": "string"
    },
    "cors": {
      "enum": [
        "supported",
        "not_supported",
        "needs_testing",
        "unknown"
      ],
      "title": "Cors",
      "type": "string"
    },
    "attribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Attribution statement shown with this operator's data.",
      "title": "Attribution"
    },
    "licence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Licence"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Licence terms for this operator's data. Null if not yet known."
    },
    "missing_publish_flag": {
      "anyOf": [
        {
          "$ref": "#/$defs/MissingPublishFlag"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Only by the repository owner's decision: show locations that have no publish flag. Null means such locations are never kept."
    },
    "relay": {
      "anyOf": [
        {
          "$ref": "#/$defs/Relay"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Only by the repository owner's decision: fetch through the project's relay. Null means requests go direct."
    },
    "engagement": {
      "$ref": "#/$defs/Engagement"
    },
    "access_requested": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Requested"
    },
    "access_granted": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Granted"
    },
    "sources": {
      "description": "Where the technical facts in this file come from.",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "findings": {
      "description": "Dated observations shown on the transparency page.",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "enabled": {
      "description": "True if the pipeline should fetch this operator.",
      "title": "Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "display_name",
    "ocpi_country_code",
    "ocpi_party_id",
    "adapter",
    "base_url",
    "auth",
    "supports_single_location",
    "cors",
    "engagement",
    "enabled"
  ],
  "title": "OperatorConfig",
  "type": "object"
}
